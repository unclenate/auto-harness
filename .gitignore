.DS_Store
legacy/Docs.pdf

# Python bytecode cache from running the reference orchestrators under reference/
__pycache__/
*.pyc

# Claude Code runtime state and generated skill links/adapters. Canonical skills
# live under platform/skills/ and should be projected into tool-local folders,
# not maintained there as independent copies.
.claude/
.remember/

# Inter-agent coordination bus runtime store (management/agent-coordination,
# PRD-0039). The reference orchestrator writes ephemeral message files under
# .coordination/bus/; these are runtime state, never governed artifacts — the
# governed contracts live under docs/coordination/.
.coordination/

# Sample-project example .claude/ directories are reference implementations
# that ship checked-in (not consumer runtime state). Negate the .claude/ ignore
# above for paths under platform/examples/sample-projects/*/.claude/.
!platform/examples/sample-projects/*/.claude/
!platform/examples/sample-projects/*/.claude/**
# ...but never track the runtime drafts the PRD-0035 auto-capture hook scaffolds
# into a sample project's .claude/drafts/ (consumer runtime state, not reference).
# In a real consumer project the global .claude/ ignore already covers this.
platform/examples/sample-projects/*/.claude/drafts/

# --- Redaction / do-not-publish safety (security review 2026-09-01) ---
# Local gitignored redaction denylist (names must never be committed; OPP-0048 mechanism 2).
.knowledge-redaction-denylist
# Untracked working directories that hold private/session state and must never be
# published by an accidental `git add -A` (surfaced by the 2026-09-01 adversarial audit).
.agents/
project-status-2026-08-04/
docs/superpowers/specs/2026-06-09-digital-twin-seed-brief.md
docs/superpowers/specs/2026-08-31-memo-response-held-drafts.md
